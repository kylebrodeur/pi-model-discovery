{
  "name": "@kylebrodeur/pi-model-discovery",
  "version": "0.7.9",
  "description": "Auto-discover local model providers (Ollama) and register their models with Pi on startup. Per-model context windows and capabilities, no /reload required.",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "ollama",
    "model-discovery",
    "local-models",
    "pi"
  ],
  "author": {
    "name": "Kyle Brodeur",
    "email": "kylebrodeur@gmail.com",
    "url": "https://github.com/kylebrodeur"
  },
  "license": "MIT",
  "homepage": "https://github.com/kylebrodeur/pi-model-discovery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylebrodeur/pi-model-discovery.git"
  },
  "bugs": {
    "url": "https://github.com/kylebrodeur/pi-model-discovery/issues"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "typescript": "^5.3.3"
  }
}
